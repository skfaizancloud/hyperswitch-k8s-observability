# ---- Python backend with OpenTelemetry auto-instrumentation (APM) ----
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt \
 && pip install --no-cache-dir \
      opentelemetry-distro==0.65b0 \
      opentelemetry-exporter-otlp==1.44.0 \
 # installs instrumentations for every library it finds (flask, requests, logging, ...)
 && opentelemetry-bootstrap -a install

COPY server.py .

# Defaults - overridden by the Kubernetes Deployment
ENV OTEL_SERVICE_NAME=hyperswitch-backend \
    OTEL_TRACES_EXPORTER=otlp \
    OTEL_METRICS_EXPORTER=otlp \
    OTEL_LOGS_EXPORTER=none \
    OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf \
    OTEL_PROPAGATORS=tracecontext,baggage \
    OTEL_PYTHON_LOG_CORRELATION=true

RUN useradd -u 10001 -m appuser
USER 10001
EXPOSE 4242

# One worker + threads avoids OTel exporter threads being lost on gunicorn fork
CMD ["opentelemetry-instrument", "gunicorn", "--bind", "0.0.0.0:4242", \
     "--workers", "1", "--threads", "8", "--access-logfile", "-", "server:app"]
