# ---- Build the React app ----
FROM node:20-alpine AS build
WORKDIR /src
COPY package.json package-lock.json ./
RUN npm ci --legacy-peer-deps --no-audit --no-fund
COPY public ./public
COPY src ./src
RUN CI=false npm run build

# ---- Serve with nginx; RUM config is written at container start ----
FROM nginx:1.27-alpine
COPY --from=build /src/build /usr/share/nginx/html
# nginx's entrypoint envsubst's templates -> /etc/nginx/conf.d/default.conf
COPY docker/nginx.conf.template /etc/nginx/templates/default.conf.template
# scripts in /docker-entrypoint.d run before nginx starts
COPY docker/40-write-config.sh /docker-entrypoint.d/40-write-config.sh
RUN chmod +x /docker-entrypoint.d/40-write-config.sh

ENV BACKEND_URL=http://hyperswitch-backend:4242
EXPOSE 80
