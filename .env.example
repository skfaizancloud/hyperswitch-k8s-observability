# Copy to .env, fill in, then: ./bootstrap.sh
# NEVER commit .env (it's in .gitignore)

# ---- Images (built by GitHub Actions, public on Docker Hub) ----
REGISTRY=docker.io/YOUR_DOCKERHUB_USER
IMAGE_TAG=latest
APP_ENV=kodekloud

# ---- Hyperswitch sandbox (https://app.hyperswitch.io -> Developers) ----
HYPERSWITCH_API_KEY=
HYPERSWITCH_PUBLISHABLE_KEY=

# ---- Datadog ----
DD_API_KEY=
DD_SITE=datadoghq.com            # match your account: datadoghq.com, us5.datadoghq.com, ap1.datadoghq.com, datadoghq.eu ...
DD_RUM_ENABLED=true
DD_RUM_APP_ID=                   # Datadog > Digital Experience > RUM > New Application (JS)
DD_RUM_CLIENT_TOKEN=

# ---- Coralogix ----
CORALOGIX_PRIVATE_KEY=           # "Send-Your-Data" API key
CORALOGIX_DOMAIN=coralogix.in    # coralogix.in (AP1/India), coralogix.com (EU1), coralogix.us (US1) ...
CX_RUM_ENABLED=true
CX_RUM_PUBLIC_KEY=               # Coralogix RUM public key (Settings > API keys > RUM)
# CX_RUM_DOMAIN=AP1              # auto-derived from CORALOGIX_DOMAIN if left empty

# ---- Which RUM SDK injects traceparent (RUM <-> APM link): datadog | coralogix | none
RUM_TRACE_LINK=datadog

# ---- Optional ----
ENABLE_LOADGEN=false             # headless-browser RUM traffic (pulls a ~2 GB image)
# DD_CHART_VERSION=              # pin once it works, e.g. 3.x.y
# CX_CHART_VERSION=
